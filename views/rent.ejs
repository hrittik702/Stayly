<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Stayly - Add your Home</title>
    <link rel="stylesheet" href="css/style.css" />
    <link rel="stylesheet" href="css/rent.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Gochi+Hand&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
      integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  </head>
  <body>
    <div id="main">
      <%- include('includes/nav.ejs') %>
      <div class="container">
        <form method="POST" action="/rent">
          <span>Title</span>
          <br />
          <input type="text" name="title" placeholder="" />
          <br /><br />
          <span>Description</span>
          <br />
          <textarea name="description" id=""></textarea>
          <br />
          <br />
          <span>Image URL</span>
          <br />
          <input type="text" name="image" />
          <br /><br />
          <span>Price</span>
          <input type="number" name="price" />
          <br /><br />
          <span>Location</span>
          <input type="text" name="location" />
          <span>Country</span>
          <input type="text" name="Country" />
          <button>Submit</button>
        </form>
      </div>
    </div>
  </body>
</html>
