<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Stayly - Rent your home</title>
    <link
      rel="shortcut icon"
      href="/Assets/stayly-logo-copy.png"
      type="image/x-icon"
      id="favicon"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/nav.css" />
    <link rel="stylesheet" href="/css/footer.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Gochi+Hand&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
      integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  </head>
  <body>
    <div id="main">
      <header>
        <nav>
          <div class="nav-left">
            <img id="stayly-logo" src="/Assets/stayly-logo-copy.png" alt="stayly-logo" />
            <div class="head">
              <p>STAYLY</p>
              <p>Find your Next Stay</p>
            </div>
          </div>
          <div class="nav-middle">
            <form method="GET" action="/rent">
              <button>Rent Your Home</button>
            </form>
          </div>
          <div class="nav-right">
            <input type="text" name="search" placeholder="Search your stay" />
            <i class="fa-solid fa-map"></i>
            <i class="fa-solid fa-bars"></i>
          </div>
        </nav>
        <div class="header-down">
          <div class="header-options">
            <p>Where</p>
            <p>When</p>
            <p>Who</p>
          </div>
        </div>
      </header>
      <%- body %>
      <footer>
        <div class="footer-start">
          <div class="footer-left">
            <img src="Assets/stayly-logo.png" alt="" />
          </div>
          <div class="footer-right"></div>
        </div>
        <div class="footer-end">
          <p>Made with &hearts; by Hrittik Maurya</p>
        </div>
      </footer>
    </div>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
