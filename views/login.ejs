<% layout("/layout/boilerplate") %>

<div class="auth-page-wrapper">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-xl-5 col-lg-6 col-md-8 col-sm-10 col-12">
        <div class="auth-card">
          <!-- Brand Badge & Header -->
          <div class="text-center mb-4">
            <div class="auth-brand-badge">
              <i class="bi bi-compass-fill"></i>
            </div>
            <h2 class="auth-title">Welcome back</h2>
            <p class="auth-subtitle">Log in to your Stayly account to manage your stays and bookings.</p>
          </div>

          <!-- Login Form -->
          <form action="/user/login" method="POST" class="needs-validation" novalidate>
            <!-- Username Input -->
            <div class="mb-3">
              <label for="username" class="auth-form-label">
                <span>Username</span>
              </label>
              <div class="input-group">
                <span class="input-group-text border-end-0">
                  <i class="bi bi-person"></i>
                </span>
                <input
                  type="text"
                  class="form-control auth-form-control border-start-0 ps-0"
                  name="username"
                  id="username"
                  placeholder="Enter your username"
                  autocomplete="username"
                  required
                />
                <div class="invalid-feedback">Please enter your username.</div>
              </div>
            </div>

            <!-- Password Input -->
            <div class="mb-3">
              <div class="d-flex align-items-center justify-content-between mb-1">
                <label for="password" class="auth-form-label mb-0">Password</label>
                <a href="#forgot" class="auth-forgot-link">Forgot password?</a>
              </div>
              <div class="input-group auth-input-group">
                <span class="input-group-text border-end-0">
                  <i class="bi bi-lock"></i>
                </span>
                <input
                  type="password"
                  class="form-control auth-form-control border-start-0 border-end-0 px-0"
                  id="password"
                  name="password"
                  placeholder="Enter your password"
                  autocomplete="current-password"
                  required
                />
                <button
                  class="btn auth-toggle-btn"
                  type="button"
                  id="togglePassword"
                  title="Show or hide password"
                >
                  <i class="bi bi-eye"></i>
                </button>
                <div class="invalid-feedback">Please enter your password.</div>
              </div>
            </div>

            <!-- Remember Me -->
            <div class="form-check auth-checkbox mb-4">
              <input class="form-check-input" type="checkbox" id="rememberMe" />
              <label class="form-check-label text-muted small user-select-none" for="rememberMe">
                Remember me on this device
              </label>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-brand w-100 py-3 fw-bold auth-submit-btn">
              <span>Log In</span>
              <i class="bi bi-arrow-right ms-2"></i>
            </button>
          </form>

          <!-- Footer Switch to Signup -->
          <div class="auth-footer-switch text-center mt-4 pt-3 border-top">
            <p class="text-muted small mb-0">
              Don't have an account yet?
              <a href="/user/signup" class="fw-bold text-brand">Sign up for free</a>
            </p>
          </div>
        </div>

        <!-- Trust & Security Badges below card -->
        <div class="auth-trust-badges d-flex align-items-center justify-content-center gap-4 mt-4">
          <span class="auth-trust-item">
            <i class="bi bi-shield-check text-brand"></i> Secure Login
          </span>
          <span class="auth-trust-item">
            <i class="bi bi-lock-fill text-muted"></i> 256-bit SSL
          </span>
          <span class="auth-trust-item">
            <i class="bi bi-stars text-warning"></i> Instant Access
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
