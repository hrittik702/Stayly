<% layout("/layout/boilerplate") %>
<head>
  <link rel="stylesheet" href="/css/show.css" />
</head>
<body>
  <main>
    <form method="POST" action="/listing/<%= editListing._id%>/edit?_method=PUT">
      <div class="title">
        <input type="text" name="title" placeholder="" value="<%= editListing.title %>" />
        <div class="host-settings">
          <button>Submit Listing</button>
        </div>
      </div>
      <p><%= editListing.description %></p>
   
      <div class="title-down">
         <div class="images">
      <img src=<%=editListing.image.url%> alt="">
    </div>
    <div class="title-down-right">
      <span>Description</span>
      <br />
      <textarea name="description"><%= editListing.description%></textarea>
      <br />
      <br />
      <span>Image URL</span>
      <br />
      <input type="text" name="image" value="<%= editListing.image.url%>" />
      <br /><br />
      <span>Price</span><br>
      <input type="number" name="price" value="<%= editListing.price %>" />
      <br /><br />
      <span>Location</span><br>
      <input type="text" name="location" value="<%= editListing.location %>" />
      <br><br>
      <span>Country</span><br>
      <input id="price" type="text" name="country" value="<%= editListing.country %>" />
    </div>
      </div>
      
    </form>
  </main>
</body>
