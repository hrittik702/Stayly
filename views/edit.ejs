<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Stayly - Edit Listing</title>
  </head>
  <body>
    <h1>Edit Listing : <%= editListing.title %></h1>
    <form method="POST" action="/listing/<%= editListing._id%>/edit?_method=PUT">
      <span>Title</span>
      <br />
      <input type="text" name="title" placeholder="" value="<%= editListing.title %>" />
      <br /><br />
      <span>Description</span>
      <br />
      <textarea name="description"><%= editListing.description%></textarea>
      <br />
      <br />
      <span>Image URL</span>
      <br />
      <input type="text" name="image" value="<%= editListing.image.url%>" />
      <br /><br />
      <span>Price</span>
      <input type="number" name="price" value="<%= editListing.price %>" />
      <br /><br />
      <span>Location</span>
      <input type="text" name="location" value="<%= editListing.location %>" />
      <span>Country</span>
      <input type="text" name="country" value="<%= editListing.country %>" />
      <button>Edit</button>
    </form>
  </body>
</html>
