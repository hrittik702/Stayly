<% layout("/layout/boilerplate") %>
<head>
  <!-- <link rel="stylesheet" href="/css/show.css" /> -->
</head>
<body>
  <main>
    <form method="POST" action="/listing/<%= editListing._id%>/edit?_method=PUT" class="needs-validation" novalidate>
      <div class="title mb-3">
        <div class="row">
          <div class="col-6">
            <input type="text" name="listing[title]" id="title" class="form-control" placeholder="" value="<%= editListing.title %>" required/>
          </div>
          
        </div>
      </div>
      <p><%= editListing.description %></p>
      <div class="title-down">
        <div class="images">
          <img src=<%=editListing.image.url%> alt="">
        </div>
        <div class="title-down-right">
          <div class="row">
            <div>
              <label for="description">Description</label>
              <textarea name="listing[description]" id="description" class="form-control mb-2" required><%= editListing.description%></textarea>
            </div>
            <div>
              <label for="image">Image URL</label>
              <input type="text" name="listing[image.url]" id="image" class="form-control mb-2" value="<%= editListing.image.url%>">
            </div>
            <div class="row">
              <div class="col-6">
                <label for="p">Price</label>
                <input type="number" name="listing[price]" id="p" class="form-control mb-2" value="<%= editListing.price %>">
              </div>
              <div class="col-6">
                <label for="country">Country</label>
                <input type="text" class="form-control mb-2" id="country" name="listing[country]" value="<%=editListing.country%>">
              </div>
            </div>
            <div>
              <label for="location">Location</label>
              <input type="text" class="form-control mb-4" id="location" name="listing[location]" value="<%=editListing.location%>">
            </div>
            <div class="host-settings col">
            <button class="btn btn-dark">Submit Listing</button>
          </div>
          </div>
        </div>
      </div>
    </form>
  </main>
</body>
