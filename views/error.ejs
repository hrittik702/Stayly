<% layout("/layout/boilerplate") %>

<div class="error-page-wrapper">
  <div class="error-card">
    <div class="error-icon-circle">
      <i class="bi bi-exclamation-triangle-fill"></i>
    </div>

    <span class="error-status-badge">
      HTTP <%= (err && err.status) ? err.status : 500 %>
    </span>

    <h2 class="fw-bold mb-3">Oops! Something went wrong</h2>

    <p class="error-message-text">
      <%= (err && err.message) ? err.message : 'We could not find the page or listing you were looking for.' %>
    </p>

    <div class="d-flex justify-content-center gap-3 flex-wrap">
      <a href="/" class="btn btn-brand px-4 py-2">
        <i class="bi bi-house-door"></i> Back to Homepage
      </a>
      <a href="/rent" class="btn btn-brand-outline px-4 py-2">
        <i class="bi bi-plus-circle"></i> Add a Listing
      </a>
    </div>
  </div>
</div>

