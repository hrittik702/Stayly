<% layout("/layout/boilerplate") %>
<main>
    <div class="title">
      <p><%= showListing.title %></p>
      <div class="host-settings">
        <a href="/listing/<%=showListing._id%>/edit"><button class="btn btn-dark">Edit Listing</button></a>
        <form method="POST" action="/listing/<%=showListing._id%>/delete?_method=DELETE">
          <button class="btn btn-dark">Delete Listing</button>
        </form>
      </div>
    </div>
    <p class="show-listing-description"><%= showListing.description %></p>
    <div class="images">
      <img src=<%=showListing.image.url%> alt="listing_image">
    </div>
    <div class="add-info">
      <span id="price">&#x20B9; <%= showListing.price ? showListing.price.toLocaleString('en-IN') : 'N/A' %></span>
      <span><%= showListing.location %>, <%= showListing.country %></span>
       
    </div>
</main>
