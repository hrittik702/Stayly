<head>
  <link rel="stylesheet" href="/css/show.css">
</head>
<% layout("/layout/boilerplate") %>
<body>
  <main>
    <div class="title">
      <p><%= showListing.title %></p>
    <div class="host-settings">
      <a href="/listing/<%=showListing._id%>/edit"><button>Edit Listing</button></a>
    <form method="POST" action="/listing/<%=showListing._id%>/delete?_method=DELETE">
      <button>Delete Listing</button>
    </form>
    </div>
    </div>
    <p><%= showListing.description %></p>
    <div class="images">
      <img src=<%=showListing.image.url%> alt="">
    </div>
    <div class="add-info">
      <span><%= showListing.location %>, <%= showListing.country %></span> <br><br>
      <span id="price">&#x20B9; <%= showListing.price.toLocaleString('en-IN') %></span> 
    </div>
  </main>
</body>
