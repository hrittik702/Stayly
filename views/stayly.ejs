<% layout("/layout/boilerplate") %>
<div class="list-container">
  <% for(let listing of listings) {%>
      <a href="/show/<%= listing._id%>">
          <div class="card" style="width: 20rem;">
          <img src=<%=listing.image.url%> class="card-img-top" alt=<%=listing.image.filename%>>
            <div class="card-body">
              <p class="card-text"> <span class="list-title"><%=listing.title%></span> <br> <span class="price">&#8377; <%= listing.price ? listing.price.toLocaleString('en-IN') : 'N/A' %> / Night </span></p>
            </div>
          </div>
      </a>
  <% } %>
</div>